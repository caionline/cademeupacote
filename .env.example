# Copie este arquivo para .env.local e preencha com suas chaves reais.
# .env.local NUNCA deve ser commitado no Git.

ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui

# Supabase (Project Settings → API Keys)
SUPABASE_URL=https://aolyvifrskdhdftgrbkd.supabase.co
SUPABASE_SECRET_KEY=sb_secret_coloque-aqui

# Lembrete de 7 dias por e-mail (Resend)
RESEND_API_KEY=re_coloque-sua-chave-aqui
# Senha qualquer, longa e aleatória. A Vercel usa pra chamar /api/cron/lembretes.
CRON_SECRET=troque-por-uma-senha-longa
# Opcional: remetente (o domínio precisa estar verificado no Resend)
# LEMBRETE_FROM=Cadê Meu Pacote <lembrete@cademeupacote.com.br>

# Opcional: troca o modelo da IA sem mexer no código (padrão: claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-haiku-5-5

# Meta (Pixel + API de Conversões). Sem estas, o site não manda nada pra Meta.
# Gerenciador de Eventos → Fontes de dados → seu Pixel (o ID é só números)
# NEXT_PUBLIC_META_PIXEL_ID=123456789012345
# Gerenciador de Eventos → Configurações → API de Conversões → Gerar token de acesso
# META_CAPI_TOKEN=coloque-o-token-aqui
# Opcional, só pra testar: código da aba "Testar eventos" (tire depois)
# META_TEST_EVENT_CODE=TEST12345
